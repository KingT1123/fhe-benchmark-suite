# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Build artifacts (SEAL harness binary/object files) — keep dir via .gitkeep
experiments/seal/build/*
!experiments/seal/build/.gitkeep

# Raw per-iteration results — regenerated by the harness, not tracked
experiments/results/raw/*
!experiments/results/raw/.gitkeep

# Aggregated/final results — regenerated by aggregate.py, not tracked
experiments/results/final/*
!experiments/results/final/.gitkeep

# Per-run logs — fully recreated by run_*_docker.sh via mkdir -p, no .gitkeep needed
experiments/results/logs/
CLAUDE.md
.claude/
