# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build artifacts (SEAL harness binary/object files) — keep dir via .gitkeep
experiments/seal/build/*
!experiments/seal/build/.gitkeep

# Local-only results archives — not for the public repo. These are
# timestamped safety copies made before overwriting/clearing raw result
# dirs during reruns; historical, not needed for reproducibility (the
# corrected raw/final CSVs they were copies of are tracked normally).
experiments/results/UPLOAD_THESE/
experiments/results/raw_pre_phase4_backup/
experiments/results/raw_backup_*/
experiments/results/raw_composite_offscope_backup_*/

# Per-run logs — fully recreated by run_*_docker.sh via mkdir -p, no .gitkeep needed
experiments/results/logs/
